# ~/chati/.env — per-machine, personal config. NOT committed (gitignored).
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# lib_chat.sh sources it automatically before applying defaults.

# --- Web search (/web) ---
# Your SearXNG endpoint(s). One URL, or several (comma-separated) to
# round-robin across them — each is a different source IP, so N instances
# ≈ N× the rate-limit budget (good for heavy batch jobs). Leave blank to
# keep /web disabled.
# export SEARXNG_URL="https://your-searxng.example.com/searx"     # single
# export SEARXNG_URLS="http://localhost:8890, https://your-searxng.example.com/searx"  # round-robin
#
# Optional tuning:
# export SEARXNG_COOLDOWN=60          # seconds to park an endpoint after a 429
# export SEARXNG_CONNECT_TIMEOUT=3    # fast failover when one endpoint is down

# Basic-auth credentials, only if your instance is protected.
# export SEARXNG_USER="your-username"
# export SEARXNG_PASS="your-password"

# --- Optional overrides (all have sensible defaults in lib_chat.sh) ---
# export DEFAULT_MODEL="gemma4:26b"       # fallback model (repo default)
# export WEB_ROUTER_MODEL="llama3.2:3b"   # pin the /web triage model
# export WEB_AUTO=0                        # disable /web triage (always search)

# --- Chat text colors (see also /color in-chat) ---
# Color your input vs the AI reply so a long transcript is easy to scan.
# Names: default black red green yellow blue magenta cyan white gray.
# export CHATI_USER_COLOR="cyan"           # your typed text (default: cyan)
# export CHATI_AI_COLOR="default"          # AI reply (default: terminal default)

# --- Prettier answers (inline TeX → Unicode) ---
# Render "$\rightarrow$", "\alpha", "x^{2}", "\leq" … as → α x² ≤ as the reply
# streams. Code blocks and `code` spans are left untouched; "$5"/"$PATH" are
# safe. Set to 0 to see the model's raw output verbatim.
# export CHATI_PRETTY=1                     # 1 = on (default), 0 = off

# --- Auto-OCR (read images/PDFs you mention) ---
# When your message names an image/PDF that exists on disk (typed or dragged
# in), chati runs `docr` on it and hands the extracted text to the model — no
# `/ocr` needed. Only real, on-disk image/PDF paths trigger it. Set to 0 to
# turn it off (the `/ocr` command still works either way).
# export CHATI_AUTO_OCR=1                    # 1 = on (default), 0 = off

# --- OCR engine ---
# chati picks the best engine per file: digital PDFs → pdftotext (instant);
# images incl. HEIC + scanned PDFs → Apple Vision on macOS (fast, accurate,
# native — built by setup.sh from docr/ocr_vision.swift); else docr/tesseract.
# Force one, or set recognition languages for Vision.
# export CHATI_OCR_ENGINE=auto              # auto (default) | vision | tesseract
# export CHATI_OCR_LANGS="es-ES en-US de-DE"  # Vision recognition languages

# --- Fine-tuning / training log ---
# Appends one JSONL record per turn (instruction, context actually sent, model
# reply) to ~/.local/share/chati/finetune/<session>.jsonl — a clean training/
# history stream, separate from conversation_histories. Set to 0 to disable.
# export CHATI_FINETUNE_LOG=1                # 1 = on (default), 0 = off

# --- External / remote Ollama (use a more powerful box) ---
# Point chati at another machine's Ollama for BOTH chat and model ops.
# OLLAMA_HOST is the standard var the `ollama` CLI reads, and chati derives its
# API URL from it, so /model, list and pull hit the same box. Each server has
# its own installed models.
# It works with ANY reachable address, not just Tailscale:
#   export OLLAMA_HOST="192.168.1.50:11434"                 # a LAN IP
#   export OLLAMA_HOST="bigbox.local:11434"                 # a hostname (mDNS)
#   export OLLAMA_HOST="heather.tailcba3e6.ts.net:11434"    # a Tailscale name
# In-chat: `/host <addr>` saves a default here; `/ollama` switches for the
# session. NOTE: only `/ollama`'s auto-DISCOVERY is Tailscale-based (it scans
# localhost + Tailscale peers) — you can still point at any LAN IP by hand.
# Auto-fallback: if a REMOTE Ollama goes away mid-use, drop back to localhost
# automatically (only if localhost answers). Set to 0 to stay on the remote.
# export CHATI_OLLAMA_FALLBACK=1            # 1 = on (default), 0 = off
# Servers you switch to with /host or /ollama are remembered in
# ~/.local/share/chati/ollama_hosts, so /ollama lists them again later.
