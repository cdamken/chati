#!/bin/bash
# summary: arranca/detiene/reinicia el servidor Ollama (envuelve ai_local/ailocal)
set -o pipefail
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" != /* ]] && _src="$_dir/$_src"; done
CHATI_DIR="$(cd -P "$(dirname "$_src")/.." && pwd)"
unset _src _dir
# shellcheck source=/dev/null
source "$CHATI_DIR/chati-common.sh"
chati_service_cmd ollama "$@"
