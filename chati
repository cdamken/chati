# Auto-start Ollama on launch if it's not already running. Silent if it
# already is; just informational otherwise.
ensure_ollama_running() {
    if ollama_running; then return 0; fi
    if ! command -v ollama >/dev/null 2>&1; then
        echo "⚠️  ollama binary not found in PATH. Install it: brew install ollama" >&2
        return 1
    fi
    echo "🚀 Starting 'ollama serve' (logs: ~/logs/ollama.log)..."
    mkdir -p "$HOME/logs"
    # Apple Silicon perf tuning (see ailocal): flash attention + q8 KV cache.
    export OLLAMA_FLASH_ATTENTION="${OLLAMA_FLASH_ATTENTION:-1}"
    export OLLAMA_KV_CACHE_TYPE="${OLLAMA_KV_CACHE_TYPE:-q8_0}"
    nohup ollama serve </dev/null >"$HOME/logs/ollama.log" 2>&1 &
    # Wait up to ~10s for the API to come up.
    local i
    for i in {1..10}; do
        sleep 1
        if ollama_running; then
            echo "   ✅ Ollama is ready."
            return 0
        fi
    done
    echo "   ⚠️  Ollama didn't become ready in 10s. Check ~/logs/ollama.log" >&2
    return 1
}

ensure_ollama_running

# Guard against a STALE explicit selection. active_model() returns a usable
# model when nothing is selected (empty/missing file), but it honors an
# explicit .active_ollama_model.txt verbatim by design — so a model that was
# selected and later removed (`ollama rm`) would otherwise make every chat
# turn fail with "model 'X' not found". Here, at startup only, if the selected
# model isn't installed while others are, switch to an installed one, persist
# it, and say so. No-op when the model is present or Ollama isn't reachable.
ensure_valid_model() {
    ollama_running || return 0
    local want installed
    want=$(active_model)
    installed=$(ollama list 2>/dev/null | tail -n +2 | awk 'NF{print $1}')
    [[ -z "$installed" ]] && return 0                 # nothing installed → active_model already warned elsewhere
    printf '%s\n' "$installed" | grep -qxF "$want" && return 0
    local pick
    pick=$(printf '%s\n' "$installed" | head -1)
    printf '%s\n' "$pick" > "$ACTIVE_MODEL_FILE"
    echo "⚠️  Selected model '$want' is not installed — switched to '$pick'."
    echo "    Change it anytime with /model, or install the original:"
    echo "      ollama pull $want"
}

# Move any pre-1.10 in-checkout sessions/settings into the stable data home
# (once) so upgrades and re-clones never orphan them again (#7). No-op after
# the first run.
migrate_legacy_state

ensure_valid_model

# Restore this session's saved toggles (or the global defaults for a fresh one)
# before showing settings, so /settings reflects the persisted config (#37).
load_active_settings

show_settings
echo "Type /h for help | /bye to exit."

while true; do
    # Recover gracefully if the active session file was deleted.
    curr_sess=$(cat "$PREVIOUS_FILE" 2>/dev/null)
    if [[ -z "$curr_sess" || ! -f "$HISTORY_DIR/$curr_sess" ]]; then
        echo "⚠️  Current session missing. Starting a new one..."
        "$MOLA_CMD" new > /dev/null
    fi

    # Colour what the user types (helps find your own lines in a long
    # transcript). Emitted around read, not inside the prompt string, so
    # readline's width math for "> " stays correct.
    [[ -n "$USER_COLOR" ]] && printf '%s' "$USER_COLOR"
    read -e -rp "> " msg
    [[ -n "$USER_COLOR" ]] && printf '%s' "$RESET_COLOR"
    [[ -z "$msg" ]] && continue
    history -s "$msg"   # in-memory only; trap flushes on exit

    if [[ "$msg" == /* ]]; then
        cmd_name="${msg%% *}"
        if [[ "$msg" == *" "* ]]; then
            cmd_args="${msg#* }"
        else
            cmd_args=""
        fi

        # Commands normally `continue` the loop. A command that wants its
        # result treated as a chat message (e.g. /m composing multiline input)
        # sets _send_after_cmd=1 to fall through to the send path instead.
        _send_after_cmd=0

        case "$cmd_name" in
            /m|/multi)
                # Compose a multiline message in $EDITOR, then send it through
                # the normal path (augment_message + agent loop) — no logic
                # duplicated. Mirrors /prompt -e's editor handling.
                editor="${EDITOR:-vi}"
                if ! command -v "$editor" >/dev/null 2>&1; then
                    echo "❌ \$EDITOR ($editor) not found. Set EDITOR to a valid command."
                else
                    _multi=$(mktemp "${TMPDIR:-/tmp}/chati_multi.XXXXXX")
                    echo "✍️  Compose your message in $editor — save & quit to send (empty = cancel)."
                    "$editor" "$_multi"
                    if [[ -s "$_multi" ]]; then
                        msg=$(cat "$_multi")
                        _send_after_cmd=1   # fall through to the send path with $msg
                    else
                        echo "⚠️  Message cancelled (empty buffer)."
                    fi
                    rm -f "$_multi"
                fi
                ;;
            /bye|/exit|/quit|/q)
                "$MOLA_CMD" save > /dev/null
                echo "Goodbye!"
                exit 0 ;;
            /h|/help|/\?) show_help ;;
            /settings)   show_settings ;;
            /defaults)
                # The editable global defaults a NEW session inherits (#37).
                if [[ "$cmd_args" == save ]]; then
                    settings_write "$DEFAULTS_SETTINGS_FILE"
                    echo "💾 Saved current settings as the default for NEW sessions."
                elif [[ "$cmd_args" == clear || "$cmd_args" == reset ]]; then
                    rm -f "$DEFAULTS_SETTINGS_FILE"
                    echo "🧹 Cleared the global defaults (new sessions start from built-in defaults)."
                else
                    if [[ -f "$DEFAULTS_SETTINGS_FILE" ]]; then
                        echo "🌐 Global defaults for new sessions:"
                        sed 's/^/   /' "$DEFAULTS_SETTINGS_FILE"
                    else
                        echo "🌐 No global defaults set — new sessions use built-in defaults."
                    fi
                    echo "   /defaults save   (make the current settings the default)   ·   /defaults clear"
                fi ;;
            /persona|/prompt)
                prompt_file=$(current_session_prompt_file)
                if [[ -z "$cmd_args" ]]; then
                    if [[ -f "$prompt_file" && -s "$prompt_file" ]]; then
                        echo "Current System Prompt ($(basename "$prompt_file")):"
                        echo "-----"
                        cat "$prompt_file"
                        echo "-----"
                    else
                        echo "No System Prompt set for this session."
                        echo "Tip: /prompt <text>  or  /prompt -e  (opens \$EDITOR)"
                    fi
                elif [[ "$cmd_args" == "-e" ]]; then
                    edit_prompt_in_editor "$prompt_file"
                elif [[ "$cmd_args" == '""' ]]; then
                    rm -f "$prompt_file"
                    echo "🗑️  System prompt cleared."
                else
                    mkdir -p "$(dirname "$prompt_file")"
                    echo "$cmd_args" > "$prompt_file"
                    echo "✅ System prompt set."
                fi
                ;;
            /sessions)   "$MOLA_CMD" list ;;
            /new)        persist_session_settings; "$MOLA_CMD" new "$cmd_args"; load_active_settings ;;
            /switch)     persist_session_settings; "$MOLA_CMD" switch "$cmd_args"; load_active_settings ;;
            /back)       persist_session_settings; "$MOLA_CMD" back; load_active_settings ;;
            # $cmd_args is left unquoted on purpose so "3 new_name" splits
            # into two args — but disable globbing first (set -f) so a
            # name like "*" isn't expanded against the cwd, then restore.
            /rename)     set -f; "$MOLA_CMD" rename $cmd_args; set +f ;;
            /autorename) set -f; "$MOLA_CMD" autorename $cmd_args; set +f ;;
            /delete)     "$MOLA_CMD" delete "$cmd_args" ;;
            /file|/f)
                # Try the whole argument as a path first so files with
                # spaces work when no instruction follows; fall back to
                # splitting on the first space (file + instruction).
                f_path=$(expand_path "$cmd_args")
                if [[ -f "$f_path" ]]; then
                    macro_fola "$f_path" ""
                else
                    read -r f_file f_instruction <<< "$cmd_args"
                    f_path=$(expand_path "$f_file")
                    macro_fola "$f_path" "$f_instruction"
                fi
                ;;
            /batch|/b)   macro_sola "$cmd_args" ;;
            /talk|/t)
                if [[ "$VOICE_MODE" == "ON" ]]; then VOICE_MODE="OFF"; else VOICE_MODE="ON"; fi
                echo "🗣️  Auto-Voice: $VOICE_MODE" ;;
            # (/colors is folded into the unified /color arm below.)
            /color|/colors)
                # ONE place for every color: chat text (you/ai) + the voice/TTS
                # highlight. `/color` with no args prints a menu of all of them.
                # `/colors [fg/bg]` stays backward-compatible → the tts target.
                csub="${cmd_args%% *}"; cval=""
                [[ "$cmd_args" == *" "* ]] && cval="${cmd_args#* }"
                if [[ "$cmd_name" == "/colors" && -n "$cmd_args" \
                      && "$csub" != tts && "$csub" != voice && "$csub" != you \
                      && "$csub" != user && "$csub" != ai ]]; then
                    csub="tts"; cval="$cmd_args"   # legacy: /colors white/green
                fi
                if [[ -z "$csub" ]]; then
                    echo "🎨 Colors — set with /color <target> <value>:"
                    echo "   Chat text:"
                    echo "     you = ${USER_COLOR}${USER_COLOR_NAME}${RESET_COLOR}   → /color you <name>"
                    echo "     ai  = ${AI_COLOR}${AI_COLOR_NAME}${RESET_COLOR}   → /color ai <name>"
                    echo "   Voice highlight (TTS, spoken text):"
                    echo "     tts = $SAY_COLORS   → /color tts <fg/bg>"
                    echo "   Names: default black red green yellow blue magenta cyan white gray"
                elif [[ "$csub" == you || "$csub" == user ]]; then
                    if [[ -n "$cval" ]]; then
                        USER_COLOR_NAME="$cval"; USER_COLOR=$(ansi_color "$cval")
                        echo "✅ Your text color → ${USER_COLOR}${cval}${RESET_COLOR}"
                    else echo "Usage: /color you <name>"; fi
                elif [[ "$csub" == ai ]]; then
                    if [[ -n "$cval" ]]; then
                        AI_COLOR_NAME="$cval"; AI_COLOR=$(ansi_color "$cval")
                        echo "✅ AI text color → ${AI_COLOR}${cval}${RESET_COLOR}"
                    else echo "Usage: /color ai <name>"; fi
                elif [[ "$csub" == tts || "$csub" == voice || "$csub" == speech ]]; then
                    # say --interactive=COLORS needs exactly fg/bg from a fixed palette.
                    if [[ "$cval" =~ ^[a-z]+/[a-z]+$ ]]; then
                        SAY_COLORS="$cval"; echo "✅ Voice highlight (TTS) → $SAY_COLORS"
                    else echo "❌ Use foreground/background, e.g. /color tts white/green"; fi
                else
                    echo "Usage: /color [you|ai <name> | tts <fg/bg>]   (run /color for the menu)"
                fi
                ;;
            /ocr)
                if [[ -n "$cmd_args" ]]; then
                    macro_ocr "$cmd_args"
                else
                    echo "❌ Provide a file, folder, or glob. e.g. /ocr ~/Downloads/scan.pdf"
                fi
                ;;
            /url)
                if [[ -n "$cmd_args" ]]; then
                    echo "🌐 Fetching $cmd_args..."
                    URL_RESULTS=$(fetch_url "$cmd_args")
                    if [[ "$URL_RESULTS" == "Error"* ]]; then
                        echo "❌ $URL_RESULTS"
                    else
                        send_and_capture "Summarize and answer questions: $URL_RESULTS"
                    fi
                else
                    echo "❌ Provide URL."
                fi
                ;;
            /shell|/s|/agent|/a)   # /agent, /a kept as backward-compat aliases
                # Shell Mode: the model proposes shell commands you approve. /s
                # never enables auto-accept. From auto-accept it de-escalates to
                # verification; otherwise it toggles ON(verification)/OFF.
                if [[ "$AGENT_AUTOACCEPT" == "ON" ]]; then
                    AGENT_AUTOACCEPT="OFF"
                    echo "🛡️  Shell: ON (verification) — auto-accept OFF; risky commands ask 'Execute? (y/N)' again."
                elif [[ "$AGENT_MODE" == "ON" ]]; then
                    AGENT_MODE="OFF"
                    echo "🐚 Shell: OFF — the AI can no longer run shell commands."
                else
                    AGENT_MODE="ON"
                    echo "🛡️  Shell: ON (verification) — the AI proposes commands; read-only ones run directly,"
                    echo "    anything that could change files/processes/network/system asks 'Execute? (y/N)'."
                fi ;;
            /sY|/aY)   # capital Y on purpose — a deliberate, can't-happen-by-accident switch (/aY = alias)
                if [[ "$AGENT_AUTOACCEPT" == "ON" ]]; then
                    AGENT_AUTOACCEPT="OFF"   # AGENT_MODE stays ON → back to verification
                    echo "🛡️  Shell: ON (verification) — auto-accept OFF; risky commands ask again."
                else
                    AGENT_MODE="ON"; AGENT_AUTOACCEPT="ON"
                    echo "🔴 ⚠️  AUTO-ACCEPT ON — the AI will run EVERY command it proposes on your Mac"
                    echo "       WITHOUT asking, INCLUDING destructive ones (rm, sudo, network, overwrites…)."
                    echo "       Only for a task you're actively watching. Ctrl-C interrupts."
                    echo "       Type /sY again (or /s) to return to verification."
                fi ;;
            /web|/w)
                if [[ "$WEB_MODE" == "ON" ]]; then
                    WEB_MODE="OFF"
                    echo "🌐 Web Search: OFF"
                else
                    # SearXNG is external — only enable /web if it actually
                    # answers, so we never pretend to have internet.
                    echo "🌐 Checking web search backend(s)..." >&2
                    web_reason=$(web_search_available 2>&1)
                    if [[ $? -eq 0 ]]; then
                        WEB_MODE="ON"
                        echo "🌐 Web Search: ON"
                        # Show which endpoints are live (round-robins over them).
                        [[ -n "$web_reason" ]] && echo "$web_reason"
                    else
                        WEB_MODE="OFF"
                        echo "🚫 Web search unavailable:"
                        echo "$web_reason"
                        echo "   Staying OFF. Set SEARXNG_URLS (or run a local SearXNG); see installer/SEARXNG_SETUP.md."
                    fi
                fi ;;
            /think)
                if [[ "$THINK_MODE" == "ON" ]]; then
                    THINK_MODE="OFF"
                    echo "💭 Thinking: OFF"
                else
                    # Only reasoning models have a thinking channel; asking a
                    # plain model to think can error and would show nothing.
                    # Gate on Ollama's JSON capability (model_can_think), which
                    # is stable across CLI/server versions.
                    think_m=$(active_model)
                    if model_can_think "$think_m"; then
                        THINK_MODE="ON"
                        echo "💭 Thinking: ON — reasoning shows in gray, then the answer ($think_m)"
                    else
                        THINK_MODE="OFF"
                        echo "🚫 '$think_m' has no 'thinking' capability — nothing to show."
                        echo "   Switch to a reasoning model with /model (e.g. deepseek-r1:7b), then /think again."
                    fi
                fi ;;
            /speed)
                if [[ -n "$cmd_args" ]]; then
                    if [[ "$cmd_args" =~ ^[0-9]*\.?[0-9]+$ ]]; then
                        SAY_SPEED="$cmd_args"
                        update_say_rate
                        echo "🗣️  Speech speed set to: ${SAY_SPEED}x ($SAY_RATE wpm)"
                    else
                        echo "❌ Invalid speed. Use a multiplier (e.g., /speed 1.5)."
                    fi
                else
                    echo "🗣️  Current speech speed: ${SAY_SPEED}x ($SAY_RATE wpm)"
                fi
                ;;
            /model)
                if [[ -n "$cmd_args" ]]; then
                    "$OLA_MODEL_CMD" set "$cmd_args"
                else
                    "$OLA_MODEL_CMD" list
                    # Interactive pick: listing alone used to leave people
                    # typing a bare "1" on the next line, which the REPL then
                    # sent as a chat message to the (maybe-missing) default
                    # model. Prompt for the choice right here instead.
                    read -e -rp "Select a model number or name (Enter to cancel): " model_sel
                    [[ -n "$model_sel" ]] && "$OLA_MODEL_CMD" set "$model_sel"
                fi ;;
            /ollama|/endpoint)
                # List Ollama servers (localhost + Tailscale peers + every server
                # you've saved before) and switch between them for THIS session.
                # Reachable ones show a version; saved-but-asleep ones show OFFLINE
                # but are still pickable. Each server has its OWN models (#39).
                o_sub="${cmd_args%% *}"
                if [[ "$o_sub" == forget ]]; then
                    o_rest="${cmd_args#forget}"; o_rest="${o_rest# }"
                    if [[ "$o_rest" == [0-9]* ]]; then
                        o_rest=$(ollama_endpoints_status | sed -n "${o_rest}p" | cut -f1)
                    fi
                    if [[ -n "$o_rest" ]]; then forget_ollama_host "$o_rest"; echo "🗑️  Forgot $o_rest"; else echo "Usage: /ollama forget <number|host>"; fi
                elif [[ -z "$cmd_args" ]]; then
                    echo "🛰️  Ollama servers (reachable + saved):"
                    ollama_idx=0
                    while IFS=$'\t' read -r o_url o_ver; do
                        ollama_idx=$((ollama_idx + 1))
                        o_mark=""; [[ "$o_url" == "$OLLAMA_API" ]] && o_mark="  ← current"
                        if [[ "$o_ver" == OFFLINE ]]; then
                            printf '   %d. %s  (saved, offline)%s\n' "$ollama_idx" "$o_url" "$o_mark"
                        else
                            printf '   %d. %s  (v%s)%s\n' "$ollama_idx" "$o_url" "$o_ver" "$o_mark"
                        fi
                    done < <(ollama_endpoints_status)
                    [[ "$ollama_idx" -eq 0 ]] && echo "   (none found — you can still point at any LAN IP by hand)"
                    echo "   Current: $OLLAMA_API"
                    echo "   Switch:  /ollama <number|host|url|local>   ·   Forget saved:  /ollama forget <n|host>"
                else
                    if [[ "$cmd_args" == local ]]; then
                        o_new="http://localhost:11434"
                    elif [[ "$cmd_args" == [0-9]* ]]; then
                        o_new=$(ollama_endpoints_status | sed -n "${cmd_args}p" | cut -f1)
                    elif [[ "$cmd_args" == http://* || "$cmd_args" == https://* ]]; then
                        o_new="$cmd_args"
                    else
                        o_new="http://$cmd_args"; [[ "$cmd_args" != *:* ]] && o_new="http://$cmd_args:11434"
                    fi
                    if [[ -z "$o_new" ]]; then
                        echo "❌ No endpoint #$cmd_args in the list — run /ollama to see them."
                    elif curl -fsS --max-time 3 "$o_new/api/version" >/dev/null 2>&1; then
                        export OLLAMA_API="$o_new"
                        o_host="${o_new#http://}"; o_host="${o_host#https://}"
                        export OLLAMA_HOST="$o_host"   # so `ollama` CLI (/model, list, pull) hits it too
                        remember_ollama_host "$o_host" # save it for next time (multiple servers kept)
                        echo "✅ Now using Ollama at $OLLAMA_API  (saved for later)"
                        echo "   Its models differ from other endpoints — run /model to pick one available here."
                    else
                        echo "❌ Can't reach $o_new (is that Ollama up and exposed?)."
                    fi
                fi ;;
            /host)
                # Set the DEFAULT Ollama endpoint and PERSIST it to .env, so it
                # survives restarts (unlike /ollama, which switches only for this
                # session). /host with no args shows the current + saved default.
                if [[ -z "$cmd_args" ]]; then
                    echo "🛰️  Ollama endpoint (now): $OLLAMA_API"
                    h_saved=$(grep -E '^[[:space:]]*(export[[:space:]]+)?OLLAMA_HOST=' "$CHAT_ENV" 2>/dev/null \
                              | tail -1 | sed -E 's/^[^=]*=//; s/^"//; s/"$//')
                    [[ -n "$h_saved" ]] && echo "   saved default (.env): $h_saved" \
                                        || echo "   no saved default (localhost unless overridden)"
                    echo "   Save a default:  /host <host|url|local>      Browse live:  /ollama"
                else
                    if [[ "$cmd_args" == local || "$cmd_args" == off || "$cmd_args" == localhost ]]; then
                        h_target=""
                    elif [[ "$cmd_args" == http://* || "$cmd_args" == https://* ]]; then
                        h_target="${cmd_args#http*://}"
                    else
                        h_target="$cmd_args"; [[ "$h_target" != *:* ]] && h_target="$h_target:11434"
                    fi
                    # Rewrite .env: drop any existing OLLAMA_HOST line, keep the
                    # rest, add the new one (unless clearing back to localhost).
                    h_tmp=$(mktemp)
                    if [[ -f "$CHAT_ENV" ]]; then
                        grep -vE '^[[:space:]]*(export[[:space:]]+)?OLLAMA_HOST=' "$CHAT_ENV" > "$h_tmp" 2>/dev/null || : > "$h_tmp"
                    else : > "$h_tmp"; fi
                    [[ -n "$h_target" ]] && printf 'export OLLAMA_HOST="%s"\n' "$h_target" >> "$h_tmp"
                    ( umask 077; mv "$h_tmp" "$CHAT_ENV" )
                    if [[ -z "$h_target" ]]; then
                        export OLLAMA_HOST="localhost:11434"; export OLLAMA_API="http://localhost:11434"
                        echo "🏠 Endpoint reset to localhost and removed from .env."
                    else
                        export OLLAMA_HOST="$h_target"; export OLLAMA_API="http://$h_target"
                        remember_ollama_host "$h_target"   # also list it under /ollama
                        if curl -fsS --max-time 3 "$OLLAMA_API/api/version" >/dev/null 2>&1; then
                            echo "✅ Saved default Ollama → $OLLAMA_API (in .env; active now and on next launch)."
                            echo "   Its models differ — run /model to pick one available here."
                        else
                            echo "💾 Saved default Ollama → $OLLAMA_API (in .env), but can't reach it right now."
                            echo "   It'll be used once it's up (wake the machine, or 'ailocal awake on' there)."
                        fi
                    fi
                fi ;;
            /lang)
                if [[ -z "$cmd_args" ]]; then
                    echo "🌐 Supported LLM response language codes:"
                    echo "${VALID_LANG_CODES[*]}"
                    echo "Current: $FORCE_LANG"
                    echo "(use /voice to set the TTS voice)"
                else
                    arg_lower=$(echo "$cmd_args" | tr '[:upper:]' '[:lower:]')
                    if [[ " ${VALID_LANG_CODES[*]} " =~ \ ${arg_lower}\  ]]; then
                        FORCE_LANG="$arg_lower"
                        echo "🌐 LLM response language set to: $FORCE_LANG"
                    else
                        echo "❌ Unknown language code: $cmd_args"
                        echo "Valid: ${VALID_LANG_CODES[*]}"
                    fi
                fi
                ;;
            /voice)
                if [[ -z "$cmd_args" ]]; then
                    echo "🗣️  Available macOS voices:"
                    say -v "?"
                    echo ""
                    echo "Current: $DEFAULT_VOICE  (AUTO = pick based on output language)"
                else
                    if [[ "$cmd_args" == "auto" || "$cmd_args" == "AUTO" ]]; then
                        DEFAULT_VOICE="AUTO"
                    else
                        DEFAULT_VOICE="$cmd_args"
                    fi
                    echo "🗣️  Voice set to: $DEFAULT_VOICE"
                fi
                ;;
            *)       echo "❓ Unknown command: $cmd_name." ;;
        esac
        # Fall through to the send path only if a command asked for it
        # (e.g. /m); every other command loops back for the next prompt.
        [[ "$_send_after_cmd" == 1 ]] || continue
    fi

    # --- Non-command: build the message and send it. ---

    # The clean instruction (before OCR/web augmentation) for the fine-tune log.
    _ft_instruction="$msg"

    # Auto-OCR (#21): if the message names image/PDF files that exist on disk,
    # extract their text with docr and fold it into the prompt — so "resume
    # ~/Downloads/factura.pdf" (or a drag-and-dropped file) just works, no
    # /ocr needed. Only real, on-disk, OCR-able paths trigger it, so ordinary
    # prose is untouched. Disable with CHATI_AUTO_OCR=0; /ocr still works too.
    if [[ "${CHATI_AUTO_OCR:-1}" != 0 ]]; then
        _ocr_files=()
        while IFS= read -r _f; do [[ -n "$_f" ]] && _ocr_files+=("$_f"); done \
            < <(detect_ocrable_in_msg "$msg")
        _ocr_max="${CHATI_AUTO_OCR_MAX:-8}"
        if (( ${#_ocr_files[@]} > _ocr_max )); then
            # docr is slow (~a minute per file); don't silently OCR a huge
            # folder. Tell the user to opt in explicitly.
            echo "📎 Found ${#_ocr_files[@]} image/PDF files — too many to OCR automatically."
            echo "   Run  /ocr <file|folder|glob>  to read them all, or name specific files."
        elif (( ${#_ocr_files[@]} )); then
            echo "📎 Detected ${#_ocr_files[@]} image/PDF file(s) — reading with docr…"
            _ocr_text=$(ocr_files_to_text "${_ocr_files[@]}")
            if [[ -n "$_ocr_text" ]]; then
                _nl=$'\n'
                msg="${msg}${_nl}${_nl}[Text extracted from the attached file(s) via OCR — use it to answer]:${_ocr_text}"
            fi
        elif msg_wants_ocr "$msg"; then
            # No path in THIS message, but you asked to read a document. First
            # reuse a path/folder you named earlier in this session, so you
            # don't have to repeat it; only if there's none do we hint.
            _hist_files=()
            while IFS= read -r _f; do [[ -n "$_f" ]] && _hist_files+=("$_f"); done \
                < <(detect_ocrable_in_history)
            if (( ${#_hist_files[@]} && ${#_hist_files[@]} <= _ocr_max )); then
                echo "📎 Reusing the ${#_hist_files[@]} image/PDF file(s) you mentioned earlier — reading with docr…"
                _ocr_text=$(ocr_files_to_text "${_hist_files[@]}")
                if [[ -n "$_ocr_text" ]]; then
                    _nl=$'\n'
                    msg="${msg}${_nl}${_nl}[Text extracted from the file(s) you referred to, via OCR — use it to answer]:${_ocr_text}"
                fi
            else
                # Nothing to go on — point the way instead of letting the model
                # claim it "can't do OCR".
                echo "💡 To read an image/PDF I run docr on it — I just need the path."
                echo "   Name the file (e.g. ~/Downloads/factura.pdf), drag it into the"
                echo "   terminal, name a folder, or use  /ocr <file|folder>."
            fi
        fi
    fi

    # Keep the raw question for conversation memory (augment_message
    # rewraps $msg with research notes; we want the clean text).
    raw_user_msg="$msg"

    msg=$(augment_message "$msg")

    # Sync the agent capability instruction with the current /a toggle.
    # When ON, ola's payload builder reads OLA_EXTRA_SYSTEM and adds it
    # as a real role:system message just before the user turn (see
    # agent_capability_prompt for the full text and rationale).
    if [[ "$AGENT_MODE" == "ON" ]]; then
        export OLA_EXTRA_SYSTEM
        OLA_EXTRA_SYSTEM=$(agent_capability_prompt)
    else
        unset OLA_EXTRA_SYSTEM
    fi

    # Auto-fallback: if we're pointed at a REMOTE Ollama that just went away
    # (asleep, off the network), drop back to localhost so you're not stuck.
    # Only runs when remote, and only if localhost actually answers. Disable
    # with CHATI_OLLAMA_FALLBACK=0.
    if [[ "${CHATI_OLLAMA_FALLBACK:-1}" != 0 ]]; then
        case "$OLLAMA_API" in
            http://localhost:11434|http://127.0.0.1:11434) ;;
            *)
                if ! curl -fsS --max-time 3 "$OLLAMA_API/api/version" >/dev/null 2>&1; then
                    if curl -fsS --max-time 3 "http://localhost:11434/api/version" >/dev/null 2>&1; then
                        echo "⚠️  Lost the remote Ollama ($OLLAMA_API) — falling back to localhost." >&2
                        export OLLAMA_API="http://localhost:11434"; export OLLAMA_HOST="localhost:11434"
                        ensure_valid_model   # the remote's model may not exist locally; pick a valid one
                    else
                        echo "⚠️  Remote Ollama ($OLLAMA_API) is unreachable, and no local Ollama to fall back to." >&2
                    fi
                fi ;;
        esac
    fi

    _ft_logged=0
    while true; do
        send_and_capture "$msg"

        # Fine-tuning log (#12): capture the user turn once — instruction, the
        # context actually sent, and the reply — before any agent sub-steps.
        if [[ "$_ft_logged" == 0 ]]; then
            log_finetune_record "$_ft_instruction" "$msg" "$LAST_RESPONSE"
            _ft_logged=1
        fi

        # Autonomous tool-use loop.
        if [[ "$AGENT_MODE" == "ON" ]] && agent_cmd=$(extract_exec_cmd "$LAST_RESPONSE"); then
            echo "🐚 AI Action: $agent_cmd"
            # Whitelist gate: clearly read-only commands (search / show / list,
            # no pipes/redirects/substitution) run without a prompt. Everything
            # else still needs an explicit y/Y — deny by default — and shows a
            # warning first. Set CHATI_AGENT_CONFIRM=all to confirm EVERYTHING
            # (the classic behaviour).
            run_it=0
            if [[ "$AGENT_AUTOACCEPT" == "ON" ]]; then
                echo "   🔴 auto-accept (/sY) — running without asking"
                run_it=1
            elif [[ "${CHATI_AGENT_CONFIRM:-}" != "all" ]] && agent_cmd_is_safe "$agent_cmd"; then
                echo "   ✅ read-only — running without confirmation"
                run_it=1
            else
                echo "   ⚠️  This may modify files, processes, network or system — review it."
                read -rp "✅ Execute? (y/N): " confirm
                agent_confirmed "$confirm" && run_it=1
            fi
            if [[ "$run_it" == 1 ]]; then
                # </dev/null: don't let the command read the REPL's stdin
                # (an interactive tool in $agent_cmd would otherwise eat
                # the user's next prompt / hang the loop).
                agent_output=$(bash -c "$agent_cmd" </dev/null 2>&1)
                agent_exit=$?
                if [[ -z "$agent_output" ]]; then
                    if (( agent_exit == 0 )); then
                        echo "📄 Output: (no output, exit=0 — command succeeded)"
                    else
                        echo "📄 Output: (no output, exit=$agent_exit — command failed)"
                    fi
                else
                    echo "📄 Output:"
                    echo "$agent_output"
                    echo "(exit=$agent_exit)"
                fi
                msg="[COMMAND]: $agent_cmd
[EXIT]: $agent_exit
[OUTPUT]:
${agent_output:-(no output)}

Interpret the exit code: 0 means the command succeeded; non-zero means it failed and OUTPUT (if any) is the error message. Do NOT claim success when exit is non-zero."
            else
                echo "🚫 Cancelled (not executed)."
                msg="User denied execution of: $agent_cmd"
            fi
            echo "--- (Autonomous Turn) ---"
        else
            break
        fi
    done

    # Remember this turn (raw question + trimmed answer) so the next /web
    # query can resolve references like "those"/"it" against it. Kept in
    # memory only — the on-disk history is bloated with research wrappers.
    # Last ~6 turns is plenty of context without ballooning the prompt.
    _RECENT_TURNS=$(printf '%suser: %s\nassistant: %s\n' \
        "${_RECENT_TURNS:-}" "$raw_user_msg" "$(printf '%s' "${LAST_RESPONSE:0:500}" | tr '\n' ' ')" \
        | tail -n 12)

    echo "---"
done
